// vouched: verified-purchase reviews on Midnight
// A store records purchase commitments; a buyer proves membership in ZK to
// post a review. The nullifier gives one review per purchase with no link
// between the purchase and the review identity.

pragma language_version 0.23;

import CompactStandardLibrary;

export ledger purchases: HistoricMerkleTree<10, Bytes<32>>;
export ledger nullifiers: Set<Bytes<32>>;
export ledger reviewTexts: Map<Bytes<32>, Opaque<"string">>;
export ledger reviewRatings: Map<Bytes<32>, Uint<8>>;
export ledger reviewProducts: Map<Bytes<32>, Bytes<32>>;
export ledger reviewCount: Counter;

witness purchaseSecret(): Bytes<32>;
witness findPurchasePath(commitment: Bytes<32>): MerkleTreePath<10, Bytes<32>>;

// Called by the store at checkout. The buyer supplies only the commitment,
// so the store never learns the secret behind it.
export circuit recordPurchase(commitment: Bytes<32>): [] {
  purchases.insert(disclose(commitment));
}

// Called by the buyer. Proves knowledge of a secret whose purchase
// commitment for this product is in the tree, without revealing which one.
export circuit postReview(productId: Bytes<32>, rating: Uint<8>, text: Opaque<"string">): [] {
  assert(rating >= 1, "rating below 1");
  assert(rating <= 5, "rating above 5");
  const secret = purchaseSecret();
  const commitment = purchaseCommitment(secret, productId);
  const path = findPurchasePath(commitment);
  assert(purchases.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(path))), "no verified purchase for this product");
  const nul = disclose(reviewNullifier(secret, productId));
  assert(!nullifiers.member(nul), "this purchase already posted a review");
  nullifiers.insert(nul);
  reviewTexts.insert(nul, disclose(text));
  reviewRatings.insert(nul, disclose(rating));
  reviewProducts.insert(nul, disclose(productId));
  reviewCount.increment(1);
}

export circuit purchaseCommitment(secret: Bytes<32>, productId: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "vouched:commit:"), productId, secret]);
}

export circuit reviewNullifier(secret: Bytes<32>, productId: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "vouched:nul:"), productId, secret]);
}
